#!/usr/bin/env bash
# FreeHop CLI: status, rotate, doctor, logs.
# Agent-friendly: status, rotate and doctor all take --json and print one
# JSON object. Exit 0 means ok, 1 means failed, 2 means usage error.
# Human-readable output is the default. All commands are idempotent and
# non-interactive.
# Usage: freehop status [--json]|rotate [--dry-run|--json]|doctor [--json]|logs|mcp|setup|teardown|help
set -euo pipefail
PREFIX="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG="${FREEHOP_CONFIG:-$HOME/.config/freehop/config}"
NETNS="freehop"; NS_IP="10.200.0.2"; PROXY_PORT="18080"; STATE_DIR="$HOME/.local/share/freehop"
WG_IF="freehop0"; KEYRING_GLOB="$HOME/.config/Proton/keyring-proton-sso-account-*.json"
WATCH_UNIT=""; TEST_CMD=""; EGRESS_METHOD="proton"; TOR_CONTROL="127.0.0.1:9051"; TOR_SOCKS_PORT="9050"; HOST_IP="10.200.0.1"; PROXY_POOL=""
if [ -f "$CONFIG" ]; then set -a; . "$CONFIG"; set +a; fi

# JSON-escape one value (prints it quoted).
esc() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }

ns_exists() {
  sudo -n ip netns list 2>/dev/null | awk '{print $1}' | grep -qx "$NETNS"
}

unit_state() { systemctl --user is-active "$1" >/dev/null 2>&1 && echo active || echo inactive; }

gather_status() {
  if ns_exists; then NS_STATE="present"; else NS_STATE="missing"; fi
  # wg indents the peer lines, so no ^ anchor on endpoint:
  WG_ENDPOINT="$(sudo -n ip netns exec "$NETNS" wg show "$WG_IF" 2>/dev/null | grep -m1 'endpoint:' | awk '{print $2}' || true)"
  if [ "$EGRESS_METHOD" = "proton" ]; then
    if sudo -n ip netns exec "$NETNS" wg show "$WG_IF" 2>/dev/null | grep -q 'latest handshake'; then
      WG_HANDSHAKE="recent"
    else
      WG_HANDSHAKE="none"
    fi
  else
    WG_HANDSHAKE="n/a"
  fi
  # Exit IP through the proxy: the same for every method, and the only
  # path that works for tor (no direct egress inside the ns).
  EXIT_IP="$(curl -s --max-time 10 --noproxy '' -x "http://$NS_IP:$PROXY_PORT" https://api.ipify.org 2>/dev/null || true)"
  UPSTREAM="direct"
  if [ -f "$STATE_DIR/upstream.json" ]; then
    UPSTREAM="$(python3 -c "import json; d=json.load(open('$STATE_DIR/upstream.json')); print(d.get('type','direct')+':'+d.get('host','')+':'+str(d.get('port','')))" 2>/dev/null || echo "?")"
  fi
  # curl prints 000 itself on failure, so do not add another one with ||.
  PROXY_CODE="$(curl -s -m 5 --noproxy '' -x "http://$NS_IP:$PROXY_PORT" -o /dev/null -w "%{http_code}" https://www.google.com/ 2>/dev/null || true)"
  [ -z "$PROXY_CODE" ] && PROXY_CODE="000"
  UNIT_PROXY="$(unit_state freehop-proxy.service)"
  UNIT_TIMER="$(unit_state freehop-watch.timer)"
  LAST_SERVER=""; LAST_EXIT=""; LAST_METHOD="$EGRESS_METHOD"
  if [ -f "$STATE_DIR/rotate-state.json" ]; then
    LAST_SERVER="$(python3 -c "import json; print(json.load(open('$STATE_DIR/rotate-state.json')).get('server',''))" 2>/dev/null || true)"
    LAST_EXIT="$(python3 -c "import json; print(json.load(open('$STATE_DIR/rotate-state.json')).get('exit_ip',''))" 2>/dev/null || true)"
    LAST_METHOD="$(python3 -c "import json; print(json.load(open('$STATE_DIR/rotate-state.json')).get('method','$EGRESS_METHOD'))" 2>/dev/null || echo "$EGRESS_METHOD")"
  fi
}

cmd_status() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  gather_status
  if [ "$json" -eq 1 ]; then
    printf '{"egress_method": %s, "netns": %s, "wg_interface": %s, "wg_endpoint": %s, "wg_handshake": %s, "exit_ip": %s, "upstream": %s, "proxy": {"url": %s, "http_code": %s}, "units": {"proxy": %s, "watch_timer": %s}, "last_rotate": {"server": %s, "exit_ip": %s, "method": %s}}\n' \
      "$(esc "$EGRESS_METHOD")" "$(esc "$NS_STATE")" "$(esc "$WG_IF")" "$(esc "$WG_ENDPOINT")" "$(esc "$WG_HANDSHAKE")" "$(esc "$EXIT_IP")" "$(esc "$UPSTREAM")" \
      "$(esc "http://$NS_IP:$PROXY_PORT")" "$(esc "$PROXY_CODE")" \
      "$(esc "$UNIT_PROXY")" "$(esc "$UNIT_TIMER")" \
      "$(esc "$LAST_SERVER")" "$(esc "$LAST_EXIT")" "$(esc "$LAST_METHOD")"
    return 0
  fi
  echo "== FreeHop status =="
  echo "egress method: $EGRESS_METHOD (upstream: $UPSTREAM)"
  "$PREFIX/scripts/freehop-netns.sh" status
  echo -n "proxy $NS_IP:$PROXY_PORT: "
  if [ "$PROXY_CODE" = "200" ]; then echo "200 OK"; else echo "unreachable"; fi
  echo "units: proxy $UNIT_PROXY, watch.timer $UNIT_TIMER"
  if [ -n "$LAST_SERVER" ]; then echo "last rotate: $LAST_SERVER $LAST_EXIT"; fi
}

# Doctor checks are recorded as name|ok|hint|severity, then printed human or
# JSON. severity "fail" (default) counts against the exit code; severity
# "warn" is a non-fatal, self-healing condition (the current exit is burned),
# reported but not fatal so infra health and exit burn stay separate.
RESULTS=()
check() {
  local name="$1" cmd="$2" hint="$3" severity="${4:-fail}"
  if eval "$cmd" >/dev/null 2>&1; then
    RESULTS+=("$name|1||$severity")
  else
    RESULTS+=("$name|0|$hint|$severity")
  fi
}

cmd_doctor() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  # Generic: every method needs these.
  check "python3" "command -v python3" "install python3"
  check "ip (iproute2)" "command -v ip" "install iproute2"
  check "iptables" "command -v iptables" "install iptables"
  check "curl" "command -v curl" "install curl"
  check "passwordless sudo" "sudo -n true" "install sudoers/freehop to /etc/sudoers.d/freehop"
  check "netns exists" "ns_exists" "run: freehop setup"
  check "proxy egress" "curl -s -m 10 --noproxy '' -x http://$NS_IP:$PROXY_PORT -o /dev/null -w %{http_code} https://www.google.com/ | grep -qx 200" "check freehop-proxy.service, run: freehop logs"
  check "proxy unit active" "systemctl --user is-active -q freehop-proxy.service" "run: systemctl --user start freehop-proxy.service"
  check "watch timer active" "systemctl --user is-active -q freehop-watch.timer" "run: systemctl --user start freehop-watch.timer"
  # State sanity: a last_rotate timestamp in the future (clock stepped back)
  # freezes the watcher's min-interval gate. Same guard the watcher applies.
  check "rotate state sane" "python3 -c \"import json,os,sys,time; p='$STATE_DIR/watch-state.json'; s=json.load(open(p)) if os.path.exists(p) else {}; sys.exit(0 if s.get('last_rotate',0) <= time.time() else 1)\"" "future last_rotate timestamp (clock stepped back); clears on the next watcher run"
  case "$EGRESS_METHOD" in
    proton)
      check "wg" "command -v wg" "install wireguard"
      check "proton vpn library" "python3 -c \"import sys,sysconfig; [sys.path.insert(0,p) for p in ('/usr/lib/python3/dist-packages',sysconfig.get_path('purelib')) if p and p not in sys.path]; import proton.vpn\"" "install the official Proton VPN Linux client"
      check "proton keyring present" "ls $KEYRING_GLOB >/dev/null 2>&1" "log in once with the Proton VPN client"
      check "certificate fetched" "test -f $STATE_DIR/cert.json" "run: freehop rotate"
      check "wg interface up" "sudo -n ip netns exec $NETNS ip link show $WG_IF 2>/dev/null | grep -q UP" "run: freehop setup"
      check "wg handshake recent" "sudo -n ip netns exec $NETNS wg show $WG_IF 2>/dev/null | grep -q 'latest handshake'" "run: freehop rotate"
      check "inside-ns egress" "sudo -n ip netns exec $NETNS curl -s -m 10 -o /dev/null -w %{http_code} https://www.google.com/ | grep -qx 200" "tunnel dead, run: freehop rotate"
      ;;
    tor)
      check "tor" "command -v tor" "install tor (apt install tor)"
      check "tor control + socks" "python3 $PREFIX/src/freehop-tor-probe.py $TOR_CONTROL $HOST_IP:$TOR_SOCKS_PORT" "is the tor daemon running? run: systemctl --user start freehop-tor.service"
      check "tor socks from ns" "sudo -n ip netns exec $NETNS curl -s --socks5-hostname $HOST_IP:$TOR_SOCKS_PORT -m 15 -o /dev/null -w %{http_code} https://www.google.com/ | grep -qx 200" "tor socks unreachable from the netns, check freehop-tor.service"
      ;;
    proxy-pool)
      check "proxy pool set" "test -n \"$PROXY_POOL\"" "set PROXY_POOL in $CONFIG (comma-separated http:// or socks5:// URLs)"
      check "inside-ns egress" "sudo -n ip netns exec $NETNS curl -s -m 10 -o /dev/null -w %{http_code} https://www.google.com/ | grep -qx 200" "netns has no route to the pool, run: freehop setup"
      ;;
    *)
      check "egress method" "false" "unknown EGRESS_METHOD: $EGRESS_METHOD (want proton, tor, or proxy-pool)"
      ;;
  esac
  # The exit-usable probe spends one free message and fails whenever the
  # current exit is burned. That is a normal, self-healing condition (the
  # watcher rotates on it), not a broken install, so it warns, not fails.
  if [ -n "$TEST_CMD" ]; then
    check "exit usable (test command)" "$TEST_CMD" "current exit burned or gateway limited; the watcher rotates automatically, or run: freehop rotate" "warn"
  fi
  local ok=0 warn=0 fail=0
  local name isok hint severity
  if [ "$json" -eq 1 ]; then
    printf '{"checks": ['
    local first=1
    while IFS='|' read -r name isok hint severity; do
      [ -n "$name" ] || continue
      if [ "$isok" = "1" ]; then ok=$((ok+1)); elif [ "$severity" = "warn" ]; then warn=$((warn+1)); else fail=$((fail+1)); fi
      [ "$first" -eq 1 ] && first=0 || printf ', '
      printf '{"name": %s, "ok": %s, "severity": %s, "hint": %s}' "$(esc "$name")" "$([ "$isok" = "1" ] && echo true || echo false)" "$(esc "$severity")" "$(esc "$hint")"
    done < <(printf '%s\n' "${RESULTS[@]}")
    printf '], "ok": %s, "warnings": %s, "failed": %s}\n' "$ok" "$warn" "$fail"
  else
    while IFS='|' read -r name isok hint severity; do
      [ -n "$name" ] || continue
      if [ "$isok" = "1" ]; then echo "[ok]   $name"; ok=$((ok+1))
      elif [ "$severity" = "warn" ]; then echo "[warn] $name ($hint)"; warn=$((warn+1))
      else echo "[FAIL] $name ($hint)"; fail=$((fail+1)); fi
    done < <(printf '%s\n' "${RESULTS[@]}")
    echo "doctor: $ok ok, $warn warning, $fail failed"
  fi
  [ "$fail" -eq 0 ]
}

cmd_mcp() {
  # Print the MCP client config for this machine (paste into the client's
  # mcpServers). The server is src/freehop-mcp.py, stdio, stdlib only.
  local mcp="$PREFIX/src/freehop-mcp.py"
  printf '{\n  "mcpServers": {\n    "freehop": {\n      "command": "python3",\n      "args": [%s]\n    }\n  }\n}\n' "$(esc "$mcp")"
}

cmd_logs() {
  tail -n 50 "$STATE_DIR/watch.log" 2>/dev/null || echo "no watch log yet"
  echo "--- proxy unit ---"
  systemctl --user status freehop-proxy.service --no-pager 2>/dev/null | head -20 || true
}

case "${1:-help}" in
  status) shift; cmd_status "$@" ;;
  rotate) shift; python3 "$PREFIX/src/freehop-rotate.py" "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  logs) cmd_logs ;;
  mcp) cmd_mcp ;;
  setup) "$PREFIX/scripts/freehop-netns.sh" setup ;;
  teardown) "$PREFIX/scripts/freehop-netns.sh" teardown ;;
  help|*) echo "usage: freehop status [--json]|rotate [--dry-run|--json]|doctor [--json]|logs|mcp|setup|teardown"; [ "${1:-help}" = "help" ] && exit 0 || exit 2 ;;
esac
