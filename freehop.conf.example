# FreeHop configuration. Copy to ~/.config/freehop/config and edit.
# All paths accept ~ and $HOME. Only the values you set here are used;
# no credentials are ever stored in this file. The Proton keyring and
# certificate stay where the Proton client and FreeHop put them.

# Egress method: which exit the gateway's traffic leaves through.
# proton (default): WireGuard to a Proton Free server, rotated on 429.
#   Needs the Proton VPN client logged in once (keyring below).
# tor: Tor daemon, SIGNAL NEWNYM rotates the exit. Needs tor installed.
#   The proxy chains through Tor's SOCKS port; the daemon is managed by
#   freehop-tor.service. Slower than Proton, and some providers block
#   Tor exits, so treat it as a fallback, not the default.
# proxy-pool: round-robin over your own upstream proxies. The proxy
#   chains to the current entry; rotate advances it. Needs PROXY_POOL.
# warp: Cloudflare WARP via wgcf. Each rotate registers a FRESH
#   anonymous WARP device (random keypair, no personal account) and
#   swaps the netns WireGuard peer to its profile. Cloudflare gives
#   each new device a fresh IPv6 address; the rotate verifies the exit
#   IPv6 /64 actually changed, because that /64 is the fresh address
#   the free limit counts (the public IPv4 egress is Cloudflare's
#   shared pool and may already be 429). Needs wgcf, downloaded once
#   (pinned release, SHA-256 verified) by the first warp rotate.
#   The old warp-cli daemon is NOT used by this method.
# Not implemented on purpose: IPv6 /64 rotation from a host /64 (this
# VPS has no IPv6 at all; warp supplies its own /64 through the tunnel).
EGRESS_METHOD=proton

# WARP (only when EGRESS_METHOD=warp): where the rotate checks the
# exit IPv6 (a URL that returns the caller's IPv6 as plain text).
WARP_EXIT_IP6_URL=https://api64.ipify.org

# Tor (only when EGRESS_METHOD=tor). SocksPort is bound to HOST_IP so the
# proxy inside the netns can reach it; the control port stays on the host.
TOR_SOCKS_PORT=9050
TOR_CONTROL=127.0.0.1:9051

# Proxy pool (only when EGRESS_METHOD=proxy-pool): comma-separated
# upstream proxies, http:// or socks5://. Rotate advances round-robin.
PROXY_POOL=

# Where the rotate checks the exit IP (a URL that returns the caller's IP
# as plain text). Default is api.ipify.org; point it at a local server
# when testing offline.
EXIT_IP_URL=https://api.ipify.org

# Network namespace and WireGuard interface (scoped, host traffic untouched)
NETNS=freehop
WG_IF=freehop0
VETH_HOST=veth-fh
VETH_NS=veth-ns
SUBNET=10.200.0.0/24
HOST_IP=10.200.0.1
NS_IP=10.200.0.2
WG_ADDR=10.2.0.2/32
PROXY_PORT=18080

# Where FreeHop keeps its state (cert, logicals, rotate state, wg key).
# Must survive reboots, so NOT /tmp.
STATE_DIR=~/.local/share/freehop
# Where the scripts live (set by install.sh).
PREFIX=~/.local/share/freehop

# Proton account. The keyring is created when you log in once with the
# official Proton VPN client; FreeHop only reads it, never writes it.
KEYRING_GLOB=~/.config/Proton/keyring-proton-sso-account-*.json

# Watch: which journal unit and pattern mean "free limit hit".
# Leave WATCH_UNIT empty to skip the 429 check and only use the tunnel
# health check.
WATCH_UNIT=
WATCH_PATTERN=FreeUsageLimitError
# Multi-word values must be quoted: this file is sourced by bash.
WATCH_SINCE="10 minutes ago"

# Command run after a successful rotate (e.g. restart your gateway so it
# drops its cached session). Leave empty for none.
POST_ROTATE_HOOK=

# Command whose exit code 0 means "the gateway works again" after a rotate.
# Leave empty to trust a successful rotate alone.
# Example for a 9Router gateway (reads its key from its own DB, key never printed):
# TEST_CMD=python3 ~/.local/share/freehop/examples/test-9router.py
TEST_CMD=

# Endpoint probe: command that prints the gateway's HTTP status code
# (200, 429, ...) and nothing else. The watcher runs it every tick; it
# is the primary 429 signal, because the gateway's journal never logs
# the 429 (the 429 only exists in the HTTP response to the caller).
# A 429 is only acted on after a second 429 PROBE_CONFIRM_SECS later,
# so a short 429 flap never rotates. Any other status never rotates.
# Leave empty to keep journal-only detection (blind on gateways that
# do not log the 429). Costs one tiny completion per 5-minute tick.
# Example for a 9Router gateway (same key handling as TEST_CMD):
# PROBE_CMD="python3 ~/.local/share/freehop/examples/test-9router.py --probe"
PROBE_CMD=
# Seconds between the first 429 probe and the confirming probe.
PROBE_CONFIRM_SECS=120

# Gateway mode: which egress the gateway uses by default.
# proxy (default): the gateway always runs behind the FreeHop proxy;
#   the watcher only rotates the exit on a confirmed 429.
# direct: the gateway runs on the host's own IP, FreeHop is the
#   fallback. On a confirmed 429 the watcher switches the gateway to
#   the proxy (restores the drop-in, restarts the gateway, no rotate
#   spent); while on the proxy it tries returning to direct every
#   RETURN_CHECK_MINS once the gateway is healthy. A failed return
#   restores the proxy, so the gateway is never stranded. The tunnel
#   stays up in both modes (it is the fallback), so doctor still
#   checks it. Needs GATEWAY_DROPIN to point at the gateway's proxy
#   drop-in (example: 9Router's freehop-proxy.conf) and GATEWAY_SERVICE
#   to be the gateway's user service.
GATEWAY_MODE=proxy
GATEWAY_SERVICE=9router.service
GATEWAY_DROPIN=~/.config/systemd/user/9router.service.d/freehop-proxy.conf
# Minutes between return-to-direct attempts while on the proxy.
RETURN_CHECK_MINS=30

# Rotate limits (same shape as the production setup that ran this nightly)
MIN_INTERVAL_MIN=10
MAX_PER_HOUR=6
MAX_PER_DAY=20
MAX_CONSEC_FAIL=3
